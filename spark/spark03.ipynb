# MAGIC ## 3.4 — groupBy() and agg()

# COMMAND –––––

# STUDY EXAMPLE

from pyspark.sql.functions import sum as _sum, avg, count

df.groupBy(“city”).agg(
_sum(“spend”).alias(“total_spend”),
avg(“spend”).alias(“avg_spend”),
count(“customer_id”).alias(“num_customers”)
).show()

