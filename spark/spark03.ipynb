# MAGIC ## 3.7 — join()

# COMMAND –––––

# STUDY EXAMPLE

orders_data = [(1, 101, 1500), (1, 102, 2000), (2, 103, 500)]
orders_df = spark.createDataFrame(orders_data, [“customer_id”, “order_id”, “amount”])

joined = df.join(orders_df, on=“customer_id”, how=“left”)
joined.show()

