# STUDY EXAMPLE — 3 ways to create a DataFrame

data = [(1, “Raj”, “Mumbai”, 5000),
(2, “Priya”, “Delhi”, 3000),
(3, “Amit”, “Mumbai”, 8000)]
columns = [“customer_id”, “name”, “city”, “spend”]

df = spark.createDataFrame(data, columns)
df.show()
df.printSchema()

