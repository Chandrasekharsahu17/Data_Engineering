# MAGIC ## 3.6 — withColumn() (adding/modifying columns)

# COMMAND –––––

# STUDY EXAMPLE

from pyspark.sql.functions import when

df_tiered = df.withColumn(
“tier”,
when(col(“spend”) > 6000, “Gold”)
.when(col(“spend”) > 3000, “Silver”)
.otherwise(“Bronze”)
)
df_tiered.show()

