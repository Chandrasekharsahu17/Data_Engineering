# MAGIC ## 3.3 — select() and filter() (SQL SELECT / WHERE equivalent)

# COMMAND –––––

# STUDY EXAMPLE

from pyspark.sql.functions import col

df.select(“name”, “city”).show()
df.filter(col(“spend”) > 4000).show()
df.filter((col(“city”) == “Mumbai”) & (col(“spend”) > 3000)).show()

